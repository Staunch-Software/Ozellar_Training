# Copy to .env and adjust.
# Postgres (production). If unset, the app falls back to a local SQLite
# file (dev.db) so you can run without installing Postgres first.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ozellar

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# JWT signing secret — MUST be set to a long random value in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me-in-production

# Public origin used in the certificate PDF's verification line / verify links.
PUBLIC_BASE_URL=https://training.ozellar.com

# --- SmartPAL (CrewingPALApp) crew-data sync — see app/smartpal_sync.py ---
# Leave USERNAME/PASSWORD unset to disable the scheduled sync entirely
# (e.g. on a local dev checkout).
# SMARTPAL_BASE_URL=https://smartpal.ozellar.com
# SMARTPAL_USERNAME=service-account@ozellar.com
# SMARTPAL_PASSWORD=change-me
# Comma-separated integer lists sent as SDCList / RankList in the sync request.
# SMARTPAL_SDC_LIST=966741
# SMARTPAL_RANK_LIST=115116,16,24,29,176,45,52,60
# SMARTPAL_PAGE_SIZE=100
# Verbose per-page/session logging for troubleshooting (off by default).
# SMARTPAL_DEBUG=1
