# Copy to .env and adjust.
# Postgres (production). If unset, the app falls back to a local SQLite
# file (dev.db) so you can run without installing Postgres first.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ozellar

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173
